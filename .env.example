# 环境变量示例 —— 复制为 .env 后填写真实值
#
# 约定（见 软件升级迭代记录.md 第七节）：
#   API Key、数据库密码等敏感信息一律放 .env，**不要写进代码**。
#   .env 不纳入分发；.env.example 只放占位符，可以入库。
#
# 用法（需要时再引入，本项目当前无此类配置）：
#   from dotenv import load_dotenv   # 需 pip install python-dotenv
#   load_dotenv(os.path.join(app_dir(), ".env"))
#   key = os.environ["MAHJONG_API_KEY"]

# —— API 相关（目前未使用，预留）——
MAHJONG_API_KEY=
MAHJONG_API_BASE_URL=

# —— 数据库相关（目前未使用，本项目无数据库）——
MAHJONG_DB_HOST=
MAHJONG_DB_PORT=
MAHJONG_DB_NAME=
MAHJONG_DB_USER=
MAHJONG_DB_PASSWORD=
